# =============================================================================
# Patent Research Workspace — environment template
# Copy to .env and fill in values. Never commit .env.
# Local development can start with Docker (Postgres + Redis + MinIO) and
# a generated AUTH_SECRET. Gemini is not required until AI phases.
# =============================================================================

# --- App ---
NODE_ENV=development
LOG_LEVEL=info

# Public URL of the NestJS API, used by the Next.js frontend only.
# Do not put secrets in NEXT_PUBLIC_* variables.
NEXT_PUBLIC_API_URL=http://localhost:3001
API_PORT=3001
WEB_PORT=3000
WORKER_PORT=8001

# --- Database (PostgreSQL + pgvector) ---
# Local Docker default (Phase 2). Replace with Neon/Supabase/Railway in production.
DATABASE_URL=postgresql://patent:patent@localhost:5432/patent
# Direct (non-pooled) URL for migrations. Same as DATABASE_URL locally.
DIRECT_DATABASE_URL=postgresql://patent:patent@localhost:5432/patent

# --- Redis / BullMQ ---
# BullMQ requires Redis 5 or newer. `pnpm db:up` publishes Redis 7 on 6380
# so it does not collide with an older Redis already bound to 6379.
REDIS_URL=redis://localhost:6380

# --- Auth ---
# Generate locally, e.g. `openssl rand -base64 48`
# Used to sign session cookies / JWTs. Backend only.
AUTH_SECRET=
AUTH_COOKIE_NAME=patent_session
# Comma-separated origins allowed to send credentials to the API.
AUTH_CORS_ORIGINS=http://localhost:3000

# --- Object storage ---
# local | s3
# Use `local` until MinIO/R2/S3 credentials exist. Files stay on disk.
STORAGE_PROVIDER=local
STORAGE_LOCAL_PATH=./data/uploads

# S3-compatible (MinIO locally, Cloudflare R2 or AWS S3 in production)
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=patent-documents
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Public/browser access should use short-lived signed URLs generated by the API.
S3_FORCE_PATH_STYLE=true

# --- AI (required from claim extraction / evidence phases; mocked until then) ---
# Google AI Studio: https://aistudio.google.com/apikey
# Backend only. Never expose to the frontend.
AI_PROVIDER=gemini
GEMINI_API_KEY=
# Inexpensive structured-output model for development (configurable).
GEMINI_MODEL=gemini-3.5-flash-lite
EMBEDDING_PROVIDER=gemini
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=768

# Optional later providers (leave empty)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Python binary used by the PDF worker. The Node worker falls back to PDF.js
# when this command is missing. Inside Docker this is `python`.
PYTHON_BIN=python

# Upload limit in bytes (default 40 MB).
MAX_UPLOAD_BYTES=41943040

# --- Observability (optional) ---
SENTRY_DSN=
